<UserControl x:Class="LocalCam.Views.Controls.AppStatusDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="18">
    <UserControl.Resources>
        <Style x:Key="FooterStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="ModeTextBlock"
                       Foreground="#E8EEF5"
                       FontWeight="Bold"
                       Text="{Binding ModeText}"
                       ToolTip="{Binding ModeToolTip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FooterStatusTextStyle}">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBasic}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding UpgradeCommand}" />
                </TextBlock.InputBindings>
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Restore purchase" Command="{Binding PlacementTarget.DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>

            <TextBlock x:Name="VersionTextBlock"
                       Style="{StaticResource FooterStatusTextStyle}"
                       Foreground="#8FA2BE"
                       FontWeight="Normal"
                       Text="{Binding VersionText}"
                       ToolTip="Click to check for updates."
                       Cursor="Hand"
                       Margin="12,0,0,0">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CheckForUpdatesCommand}" />
                </TextBlock.InputBindings>
            </TextBlock>
        </StackPanel>

        <Popup PlacementTarget="{Binding ElementName=VersionTextBlock}"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="{Binding IsToastOpen}">
            <Border Background="#233045"
                    BorderBrush="#3B4960"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    Margin="0,0,0,6">
                <TextBlock Foreground="#E8EEF5"
                           FontSize="11"
                           Text="{Binding ToastText}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
