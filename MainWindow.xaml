<Window x:Class="LocalCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="LocalCam - Network Camera Viewer"
        Height="722"
        Width="980"
        MinHeight="400"
        MinWidth="579.3333333333334"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="{x:Null}"
        Icon="pack://application:,,,/Assets/icon.ico"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarIconBrush" Color="#E8EEF5" />

        <Style x:Key="TitleBarControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#313741" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A4452" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1624" />
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="BorderBrush" Value="#34405A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="Background" Value="#26364D" />
            <Setter Property="BorderBrush" Value="#365070" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#304665" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37557A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBoxBorder"
                                Background="{x:Null}"
                                BorderBrush="{x:Null}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Indicator"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="3"
                                        Background="#0F1624"
                                        BorderBrush="#365070"
                                        BorderThickness="1"
                                        Margin="0,0,8,0">
                                    <Path x:Name="CheckGlyph"
                                          Data="M2,7 L5,10 L11,3"
                                          Stroke="#E8EEF5"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="#365070" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CameraCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#202736" />
            <Setter Property="BorderBrush" Value="#2D3648" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="CameraVideoViewStyle" TargetType="vlc:VideoView">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="CameraVideoHostStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#202736" />
        </Style>

        <Style x:Key="CameraBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,8,8,6" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#880B0F17" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="CameraOverlayIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CameraPlaceholderStyle" TargetType="Border">
            <Setter Property="Background" Value="#202736" />
            <Setter Property="Margin" Value="8,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="AppStatusUpgradeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2E6DDE" />
            <Setter Property="BorderBrush" Value="#2E6DDE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1,4,1" />
            <Setter Property="Margin" Value="6,1,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A7AE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2760C8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppStatusUpdateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2E6DDE" />
            <Setter Property="BorderBrush" Value="#2E6DDE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1,4,1" />
            <Setter Property="Margin" Value="6,1,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A7AE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2760C8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="0"
            Background="#101722"
            BorderBrush="#2A3242"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid Background="{x:Null}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="6,6,0,0"
                    ClipToBounds="True"
                    Height="42"
                    Visibility="Visible"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/Assets/icon.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="LocalCam - Network Camera Viewer"
                                   Foreground="#E8EEF5"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleBarControlButtonStyle}"
                                Click="MinimizeButton_Click">
                            <Path Data="M2,6 L12,6"
                                  Stroke="{StaticResource TitleBarIconBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square" />
                        </Button>
                        <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource TitleBarControlButtonStyle}"
                                Click="MaximizeRestoreButton_Click">
                            <Path x:Name="MaximizeIconPath"
                                  Data="M2,2 L12,2 12,12 2,12 Z"
                                  Stroke="{StaticResource TitleBarIconBrush}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  StrokeLineJoin="Miter" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="CloseButton_Click">
                            <Path Data="M2,2 L12,12 M12,2 L2,12"
                                  Stroke="{StaticResource TitleBarIconBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="6" Background="{x:Null}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{x:Null}"
                        Margin="0,0,0,10">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DetectCameraButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Content="Detect Camera"
                                    Width="118"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Click="DetectCameraButton_Click" />
                            <Button x:Name="ToolbarStartStreamsButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Content="Start All"
                                    Width="112"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="ToolbarStartStreamsButton_Click" />
                            <Button x:Name="ToolbarStopButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Content="Stop All"
                                    Width="72"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="ToolbarStopButton_Click" />
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Content="Settings"
                                    Width="88"
                                    Height="30"
                                    Click="SettingsButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#1B2231"
                        BorderBrush="#2D3648"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StreamingStatusText"
                                   Grid.Column="0"
                                   Foreground="#8FA2BE"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Text="Search local camera to populate the empty camera cards." />
                        <ProgressBar x:Name="SearchProgressBar"
                                     Grid.Column="1"
                                     Width="120"
                                     Height="4"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid x:Name="CameraTilesPanel" Grid.Row="2" Visibility="Collapsed" />

            </Grid>

            <Border Grid.Row="2"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    BorderThickness="0"
                    CornerRadius="0,0,6,6"
                    Visibility="Visible"
                    Padding="10,6">
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Foreground="#8FA2BE"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Text="© 2026 JustinTagarda" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="AppModeStatusText"
                                       Foreground="#8FA2BE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"
                                       Focusable="False"
                                       Text="" />
                            <Button x:Name="UpgradeButton"
                                    Style="{StaticResource AppStatusUpgradeButtonStyle}"
                                    Content="Upgrade"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Focusable="False"
                                    Click="UpgradeButton_Click" />
                            <TextBlock x:Name="FooterVersionText"
                                       Foreground="#8FA2BE"
                                       FontSize="11"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Text="v1.0.0.0" />
                            <Button x:Name="UpdateButton"
                                    Style="{StaticResource AppStatusUpdateButtonStyle}"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Focusable="False"
                                    Click="UpdateButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6,1 L6,7 M3.5,4.5 L6,7 L8.5,4.5 M2,8.5 L10,8.5 L10,11 L2,11 Z"
                                          Stroke="White"
                                          Fill="Transparent"
                                          StrokeThickness="1.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12"
                                          Height="12"
                                          Stretch="Fill"
                                          Margin="0,0,4,0" />
                                    <TextBlock Text="Update"
                                               Foreground="White"
                                               FontWeight="Normal"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>



