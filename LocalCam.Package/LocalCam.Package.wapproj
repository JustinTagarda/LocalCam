<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <ProjectGuid>{7A9B9E1C-0E45-4B9A-8D91-7E1E53E9D901}</ProjectGuid>
    <ProjectName>LocalCam.Package</ProjectName>
    <EntryPointProjectUniqueName>..\LocalCam.csproj</EntryPointProjectUniqueName>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <AppxPackageDir>$(MSBuildThisFileDirectory)AppPackages\</AppxPackageDir>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <ExpectedStoreIdentityName>JustinTagardaSoftware.LocalCam</ExpectedStoreIdentityName>
    <ExpectedStoreIdentityPublisher>CN=68EC506E-4B5E-416B-93E8-BA707CA3BE0F</ExpectedStoreIdentityPublisher>
    <ExpectedStoreDisplayName>LocalCam</ExpectedStoreDisplayName>
    <ExpectedStorePublisherDisplayName>JustinTagarda</ExpectedStorePublisherDisplayName>
    <ExpectedStoreVersionPattern>^\d+\.\d+\.\d+\.0$</ExpectedStoreVersionPattern>
    <LastStoreUploadInfoPath>$(MSBuildThisFileDirectory)obj\x64\Release\_upkginfo.txt</LastStoreUploadInfoPath>
    <StoreSdkPinPath>D:\Projects\global.json</StoreSdkPinPath>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)Assets\StoreLogo.png">
      <Link>Assets\StoreLogo.png</Link>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Assets\Square44x44Logo.png">
      <Link>Assets\Square44x44Logo.png</Link>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Assets\Square150x150Logo.png">
      <Link>Assets\Square150x150Logo.png</Link>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Assets\Wide310x150Logo.png">
      <Link>Assets\Wide310x150Logo.png</Link>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)Assets\SplashScreen.png">
      <Link>Assets\SplashScreen.png</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalCam.csproj" />
  </ItemGroup>

  <Target Name="PrepareStorePackageArtifacts" BeforeTargets="_CopyProjectAppxManifestToAppxUpload">
    <ReadLinesFromFile File="$(LastStoreUploadInfoPath)" Condition="Exists('$(LastStoreUploadInfoPath)')">
      <Output TaskParameter="Lines" PropertyName="LastStoreUploadArtifactPath" />
    </ReadLinesFromFile>
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Name">
      <Output TaskParameter="Result" PropertyName="ActualStoreIdentityName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Publisher">
      <Output TaskParameter="Result" PropertyName="ActualStoreIdentityPublisher" />
    </XmlPeek>
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="ActualStoreVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='DisplayName']/text()">
      <Output TaskParameter="Result" PropertyName="ActualStoreDisplayName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='PublisherDisplayName']/text()">
      <Output TaskParameter="Result" PropertyName="ActualStorePublisherDisplayName" />
    </XmlPeek>
    <Error Condition="'$(ActualStoreIdentityName)' != '$(ExpectedStoreIdentityName)'" Text="Package.appxmanifest Identity Name mismatch. Expected '$(ExpectedStoreIdentityName)', found '$(ActualStoreIdentityName)'." />
    <Error Condition="'$(ActualStoreIdentityPublisher)' != '$(ExpectedStoreIdentityPublisher)'" Text="Package.appxmanifest Identity Publisher mismatch. Expected '$(ExpectedStoreIdentityPublisher)', found '$(ActualStoreIdentityPublisher)'." />
    <Error Condition="'$(ActualStoreDisplayName)' != '$(ExpectedStoreDisplayName)'" Text="Package.appxmanifest DisplayName mismatch. Expected '$(ExpectedStoreDisplayName)', found '$(ActualStoreDisplayName)'." />
    <Error Condition="'$(ActualStorePublisherDisplayName)' != '$(ExpectedStorePublisherDisplayName)'" Text="Package.appxmanifest PublisherDisplayName mismatch. Expected '$(ExpectedStorePublisherDisplayName)', found '$(ActualStorePublisherDisplayName)'." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ActualStoreVersion)', '$(ExpectedStoreVersionPattern)'))" Text="Package.appxmanifest Identity Version must use Major.Minor.Build.0 format. Found '$(ActualStoreVersion)'." />
    <PropertyGroup>
      <LastStoreUploadVersion>$([System.Text.RegularExpressions.Regex]::Match('$(LastStoreUploadArtifactPath)', 'LocalCam\.Package_(\d+\.\d+\.\d+\.\d+)_x64\.msixupload').Groups[1].Value)</LastStoreUploadVersion>
    </PropertyGroup>
    <Error Condition="'$(LastStoreUploadVersion)' == '$(ActualStoreVersion)'" Text="Package.appxmanifest Identity Version '$(ActualStoreVersion)' matches the most recently generated Store package. Increment the version before building a new Store package." />
    <RemoveDir Directories="$(AppxPackageDir)" Condition="Exists('$(AppxPackageDir)')" />
    <RemoveDir Directories="$(MSBuildThisFileDirectory)bin\x64\Release\Upload" Condition="Exists('$(MSBuildThisFileDirectory)bin\x64\Release\Upload')" />
  </Target>

  <Target Name="ValidateStoreSdkPin" BeforeTargets="PrepareStorePackageArtifacts">
    <Error Condition="!Exists('$(StoreSdkPinPath)')" Text="Store packaging SDK pin file not found at '$(StoreSdkPinPath)'." />
    <ReadLinesFromFile File="$(StoreSdkPinPath)">
      <Output TaskParameter="Lines" ItemName="StoreSdkPinLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <StoreSdkPinText>@(StoreSdkPinLines, ' ')</StoreSdkPinText>
      <PinnedStoreSdkVersion>$([System.Text.RegularExpressions.Regex]::Match('$(StoreSdkPinText)', '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</PinnedStoreSdkVersion>
      <ResolvedStoreSdkRoot>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetFullPath('$(BundledRuntimeIdentifierGraphFile)'))))</ResolvedStoreSdkRoot>
      <ResolvedStoreSdkVersion>$([System.IO.Path]::GetFileName('$(ResolvedStoreSdkRoot)'))</ResolvedStoreSdkVersion>
    </PropertyGroup>
    <Error Condition="'$(PinnedStoreSdkVersion)' == ''" Text="Unable to read the pinned SDK version from '$(StoreSdkPinPath)'." />
    <Error Condition="'$(ResolvedStoreSdkVersion)' != '$(PinnedStoreSdkVersion)'" Text="Store packaging SDK mismatch. Expected '$(PinnedStoreSdkVersion)' from '$(StoreSdkPinPath)', found '$(ResolvedStoreSdkVersion)'." />
    <Error Condition="!$([System.String]::Equals('$(ResolvedStoreSdkRoot)', 'C:\Program Files\dotnet\sdk\$(PinnedStoreSdkVersion)', System.StringComparison.OrdinalIgnoreCase))" Text="Store packaging SDK resolver root mismatch. Expected 'C:\Program Files\dotnet\sdk\$(PinnedStoreSdkVersion)', found '$(ResolvedStoreSdkRoot)'." />
  </Target>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" />
</Project>
