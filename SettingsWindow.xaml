<Window x:Class="LocalCam.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCam - Settings"
        Width="620"
        MinWidth="620"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
            Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarIconBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    Background="{DynamicResource InputBackgroundBrush}">
                                <Path x:Name="CheckMark"
                                      Data="M3,9 L7,13 L15,4"
                                    Stroke="{DynamicResource CheckboxBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="DialogComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    CornerRadius="6,6,0,0"
                    Height="42"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/Assets/icon.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="Settings"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="CloseButton_Click">
                        <Path Data="M2,2 L12,12 M12,2 L2,12"
                              Stroke="{StaticResource TitleBarIconBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Startup"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Behavior"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <CheckBox x:Name="AutoDetectOnStartupCheckBox"
                              Grid.Column="1"
                              Content="Auto detect on startup"
                              Style="{StaticResource DialogCheckBoxStyle}"
                              Checked="InputChanged"
                              Unchecked="InputChanged" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Detection"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <CheckBox x:Name="AutoStartWhenConnectedCheckBox"
                              Grid.Column="1"
                              Content="Auto start when connected"
                              Style="{StaticResource DialogCheckBoxStyle}"
                              Checked="InputChanged"
                              Unchecked="InputChanged" />
                </Grid>

                <Border Grid.Row="3"
                        Height="1"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Margin="0,2,0,12" />

                <TextBlock Grid.Row="4"
                           Text="RTSP Credentials"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="RTSP Username"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="RtspUsernameTextBox"
                             Grid.Column="1"
                             TextChanged="InputChanged"
                             Style="{StaticResource DialogTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="6" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="RTSP Password"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <PasswordBox x:Name="RtspPasswordBox"
                                 Grid.Column="1"
                                 PasswordChanged="InputChanged"
                                 Style="{StaticResource DialogPasswordBoxStyle}" />
                </Grid>

                <Grid Grid.Row="7" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Stream Path"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="StreamPathTextBox"
                             Grid.Column="1"
                             TextChanged="InputChanged"
                             Style="{StaticResource DialogTextBoxStyle}" />
                </Grid>

                <Border Grid.Row="8"
                        Height="1"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Margin="0,2,0,12" />

                <TextBlock Grid.Row="9"
                           Text="Snapshot"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="10" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Snapshot Folder"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SnapshotFolderTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 IsReadOnly="True"
                                 MinWidth="0"
                                 Margin="0,0,8,0"
                                 TextChanged="InputChanged"
                                 ToolTip="If empty, default is Pictures\\LocalCam." />
                        <Button x:Name="BrowseSnapshotFolderButton"
                                Grid.Column="1"
                                Style="{StaticResource DialogIconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Browse snapshot folder"
                                Click="BrowseSnapshotFolderButton_Click">
                            <Path Data="M2,6 L6,6 L8,4 L14,4 L14,12 L2,12 Z"
                                  Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ResetSnapshotFolderButton"
                                Grid.Column="2"
                                Style="{StaticResource DialogIconButtonStyle}"
                                ToolTip="Reset to default (Pictures\\LocalCam)"
                                Click="ResetSnapshotFolderButton_Click">
                            <Path Data="M4,4 A4,4 0 1 1 3.9,4 M4,1 L4,4 L7,4"
                                  Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="11"
                           Text="Recording"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="12" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Recording Folder"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecordingFolderTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 IsReadOnly="True"
                                 MinWidth="0"
                                 Margin="0,0,8,0"
                                 TextChanged="InputChanged"
                                 ToolTip="If empty, default is Videos\\LocalCam." />
                        <Button x:Name="BrowseRecordingFolderButton"
                                Grid.Column="1"
                                Style="{StaticResource DialogIconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Browse recording folder"
                                Click="BrowseRecordingFolderButton_Click">
                            <Path Data="M2,6 L6,6 L8,4 L14,4 L14,12 L2,12 Z"
                                  Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ResetRecordingFolderButton"
                                Grid.Column="2"
                                Style="{StaticResource DialogIconButtonStyle}"
                                ToolTip="Reset to default (Videos\\LocalCam)"
                                Click="ResetRecordingFolderButton_Click">
                            <Path Data="M4,4 A4,4 0 1 1 3.9,4 M4,1 L4,4 L7,4"
                                  Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="13" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Theme" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="ThemePreferenceComboBox" Width="140" Height="28" Style="{StaticResource DialogComboBoxStyle}" ItemContainerStyle="{StaticResource DialogComboBoxItemStyle}" SelectedValuePath="Tag" SelectionChanged="ThemePreferenceComboBox_SelectionChanged">
                                <ComboBoxItem Content="System" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="InlineErrorTextBlock" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Update"
                                Margin="0,0,8,0"
                                Click="UpdateButton_Click" />
                        <Button x:Name="CancelButton"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>


