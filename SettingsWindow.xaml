<Window x:Class="LocalCam.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCam - Settings"
        Width="620"
        MinWidth="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{x:Null}"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SettingsStatusUpgradeButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="4,1,4,1" />
            <Setter Property="Margin" Value="6,1,0,1" />
        </Style>

        <Style x:Key="DialogCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    Background="{DynamicResource InputBackgroundBrush}">
                                <Path x:Name="CheckMark"
                                      Data="M3,9 L7,13 L15,4"
                                    Stroke="{DynamicResource CheckboxBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="18,16,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Startup"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="Behavior"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                     <CheckBox x:Name="ReconnectRecentCamerasOnStartupCheckBox"
                              Grid.Column="1"
                              Content="Reconnect recent cameras on startup"
                              Style="{StaticResource DialogCheckBoxStyle}"
                              Checked="InputChanged"
                              Unchecked="InputChanged" />
                </Grid>

                <Border Grid.Row="3"
                        Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,2,0,12" />

                <TextBlock Grid.Row="4"
                           Text="RTSP Credentials"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="RTSP Username"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                     <Grid Grid.Column="1">
                     <TextBox x:Name="RtspUsernameTextBox"
                                   TextChanged="InputChanged"
                                   Style="{StaticResource DialogTextBoxStyle}" />
                         <TextBlock x:Name="RtspUsernamePlaceholderTextBlock"
                                    Text="Enter RTSP username"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                     </Grid>
                </Grid>

                <Grid Grid.Row="6" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="RTSP Password"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                     <Grid Grid.Column="1">
                     <PasswordBox x:Name="RtspPasswordBox"
                                      PasswordChanged="InputChanged"
                                      Style="{StaticResource DialogPasswordBoxStyle}" />
                         <TextBlock x:Name="RtspPasswordPlaceholderTextBlock"
                                    Text="Enter RTSP password"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                     </Grid>
                </Grid>

                <Grid Grid.Row="7" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="Stream Path"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="StreamPathTextBox"
                                 TextChanged="InputChanged"
                                 Style="{StaticResource DialogTextBoxStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap">
                            <Run Text="Need help configuring your camera? "
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Hyperlink NavigateUri="https://justintagarda.com/docs/localcam-camera-setup-guide.html"
                                       RequestNavigate="CameraSetupGuideHyperlink_RequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}"
                                       AutomationProperties.Name="Open the camera setup guide">
                                Open the camera setup guide
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="8"
                        Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,2,0,12" />

                <TextBlock Grid.Row="9"
                           Text="Media Location"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="10" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="Snapshot Folder"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                     <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SnapshotFolderTextBox"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     IsReadOnly="True"
                                     MinWidth="0"
                                     Margin="0,0,8,0"
                                     TextChanged="InputChanged"
                                     ToolTip="If empty, default is Pictures\\LocalCam." />
                            <Button x:Name="BrowseSnapshotFolderButton"
                                    Grid.Column="1"
                                    Style="{StaticResource DialogIconButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="Browse snapshot folder"
                                    Click="BrowseSnapshotFolderButton_Click">
                                <Path Data="M2,5.5 L6.5,5.5 L8,4 L14,4 L14,12 L2,12 Z M2,7 L14,7"
                                       Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.3"
                                      Fill="Transparent"
                                      StrokeLineJoin="Round" />
                            </Button>
                            <Button x:Name="ResetSnapshotFolderButton"
                                    Grid.Column="2"
                                    Style="{StaticResource DialogIconButtonStyle}"
                                    ToolTip="Reset to default (Pictures\\LocalCam)"
                                    Click="ResetSnapshotFolderButton_Click">
                                <Path Data="M13,6 A5,5 0 1 0 13.5,9 M13,3 L13,6 L10,6"
                                       Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.3"
                                      Fill="Transparent"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                     </Grid>

                <Grid Grid.Row="11" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                     <TextBlock Text="Recording Folder"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                     <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RecordingFolderTextBox"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     IsReadOnly="True"
                                     MinWidth="0"
                                     Margin="0,0,8,0"
                                     TextChanged="InputChanged"
                                     ToolTip="If empty, default is Videos\\LocalCam." />
                            <Button x:Name="BrowseRecordingFolderButton"
                                    Grid.Column="1"
                                    Style="{StaticResource DialogIconButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="Browse recording folder"
                                    Click="BrowseRecordingFolderButton_Click">
                                <Path Data="M2,5.5 L6.5,5.5 L8,4 L14,4 L14,12 L2,12 Z M2,7 L14,7"
                                       Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.3"
                                      Fill="Transparent"
                                      StrokeLineJoin="Round" />
                            </Button>
                            <Button x:Name="ResetRecordingFolderButton"
                                    Grid.Column="2"
                                    Style="{StaticResource DialogIconButtonStyle}"
                                    ToolTip="Reset to default (Videos\\LocalCam)"
                                    Click="ResetRecordingFolderButton_Click">
                                <Path Data="M13,6 A5,5 0 1 0 13.5,9 M13,3 L13,6 L10,6"
                                       Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.3"
                                      Fill="Transparent"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                     </Grid>

                <Grid Grid.Row="12" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Theme" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="ThemePreferenceComboBox" Width="140" Height="28" SelectedValuePath="Tag" SelectionChanged="ThemePreferenceComboBox_SelectionChanged">
                                <ComboBoxItem Content="System" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="InlineErrorTextBlock" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource GlobalButtonStyle}"
                                Content="Update"
                                Margin="0,0,8,0"
                                Click="UpdateButton_Click" />
                        <Button x:Name="CancelButton"
                                Style="{StaticResource GlobalButtonStyle}"
                                Content="Cancel"
                                Click="CancelButton_Click" />
                        </StackPanel>
                    </Grid>

            </Grid>

        <Border Grid.Row="1"
                Background="{x:Null}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Visible"
                Padding="10,6"
                Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Text="© 2026 JustinTagarda" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PremiumStatusTextBlock"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontWeight="Bold"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"
                               Focusable="False"
                               Text="" />
                    <Button x:Name="PremiumUpgradeButton"
                            Style="{StaticResource SettingsStatusUpgradeButtonStyle}"
                            Content="Upgrade"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            IsEnabled="False"
                            Focusable="False"
                            Click="PremiumUpgradeButton_Click" />
                    <TextBlock x:Name="SettingsVersionTextBlock"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Text="v1.0.0.0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


