<Window x:Class="LocalCam.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCam - Settings"
        Width="620"
        MinWidth="620"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarIconBrush" Color="#E8EEF5" />

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C50F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1624" />
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="BorderBrush" Value="#34405A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F1624" />
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="BorderBrush" Value="#34405A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="Background" Value="#26364D" />
            <Setter Property="BorderBrush" Value="#365070" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#304665" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37557A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="Background" Value="#26364D" />
            <Setter Property="BorderBrush" Value="#365070" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#304665" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37557A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            Background="#161B25"
            BorderBrush="#2A3242"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#101722"
                    CornerRadius="6,6,0,0"
                    Height="42"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/Assets/icon.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="Settings"
                                   Foreground="#E8EEF5"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="CloseButton_Click">
                        <Path Data="M2,2 L12,12 M12,2 L2,12"
                              Stroke="{StaticResource TitleBarIconBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="RTSP Credentials"
                           Foreground="#E8EEF5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="RTSP Username"
                               Foreground="#A9B4C7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="RtspUsernameTextBox"
                             Grid.Column="1"
                             TextChanged="InputChanged"
                             Style="{StaticResource DialogTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="RTSP Password"
                               Foreground="#A9B4C7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <PasswordBox x:Name="RtspPasswordBox"
                                 Grid.Column="1"
                                 PasswordChanged="InputChanged"
                                 Style="{StaticResource DialogPasswordBoxStyle}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Stream Path"
                               Foreground="#A9B4C7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="StreamPathTextBox"
                             Grid.Column="1"
                             TextChanged="InputChanged"
                             Style="{StaticResource DialogTextBoxStyle}" />
                </Grid>

                <Border Grid.Row="4"
                        Height="1"
                        Background="#2A3242"
                        Margin="0,2,0,12" />

                <TextBlock Grid.Row="5"
                           Text="Snapshot"
                           Foreground="#E8EEF5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="6" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Snapshot Folder"
                               Foreground="#A9B4C7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SnapshotFolderTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 IsReadOnly="True"
                                 MinWidth="0"
                                 Margin="0,0,8,0"
                                 TextChanged="InputChanged"
                                 ToolTip="If empty, default is Pictures\\LocalCam." />
                        <Button x:Name="BrowseSnapshotFolderButton"
                                Grid.Column="1"
                                Style="{StaticResource DialogIconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Browse snapshot folder"
                                Click="BrowseSnapshotFolderButton_Click">
                            <Path Data="M2,6 L6,6 L8,4 L14,4 L14,12 L2,12 Z"
                                  Stroke="#E8EEF5"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ResetSnapshotFolderButton"
                                Grid.Column="2"
                                Style="{StaticResource DialogIconButtonStyle}"
                                ToolTip="Reset to default (Pictures\\LocalCam)"
                                Click="ResetSnapshotFolderButton_Click">
                            <Path Data="M4,4 A4,4 0 1 1 3.9,4 M4,1 L4,4 L7,4"
                                  Stroke="#E8EEF5"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="7"
                           Text="Recording"
                           Foreground="#E8EEF5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid Grid.Row="8" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Recording Folder"
                               Foreground="#A9B4C7"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecordingFolderTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 IsReadOnly="True"
                                 MinWidth="0"
                                 Margin="0,0,8,0"
                                 TextChanged="InputChanged"
                                 ToolTip="If empty, default is Videos\\LocalCam." />
                        <Button x:Name="BrowseRecordingFolderButton"
                                Grid.Column="1"
                                Style="{StaticResource DialogIconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Browse recording folder"
                                Click="BrowseRecordingFolderButton_Click">
                            <Path Data="M2,6 L6,6 L8,4 L14,4 L14,12 L2,12 Z"
                                  Stroke="#E8EEF5"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="ResetRecordingFolderButton"
                                Grid.Column="2"
                                Style="{StaticResource DialogIconButtonStyle}"
                                ToolTip="Reset to default (Videos\\LocalCam)"
                                Click="ResetRecordingFolderButton_Click">
                            <Path Data="M4,4 A4,4 0 1 1 3.9,4 M4,1 L4,4 L7,4"
                                  Stroke="#E8EEF5"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="9" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="InlineErrorTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#EF4444"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Update"
                                Margin="0,0,8,0"
                                Click="UpdateButton_Click" />
                        <Button x:Name="CancelButton"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>


