<Application x:Class="LocalCam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101722" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B2231" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#202736" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F1624" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EEF5" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A9B4C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA2BE" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2D3648" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#34405A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#365070" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#26364D" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#304665" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#37557A" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="RecordingBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#AA111827" />
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="#CC365070" />
        <SolidColorBrush x:Key="OverlayToolbarBrush" Color="#CC1B2231" />
        <SolidColorBrush x:Key="StopBrush" Color="#E11D48" />
        <SolidColorBrush x:Key="PlayBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="CheckboxBrush" Color="#0EA5E9" />
    </Application.Resources>
</Application>
