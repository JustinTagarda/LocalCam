<Application x:Class="LocalCam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource ControlFillColorDefault}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource TextFillColorTertiary}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentFillColorDefault}" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ControlFillColorDefault}" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ControlFillColorSecondary}" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="{DynamicResource ControlFillColorTertiary}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SystemFillColorSuccess}" />
        <SolidColorBrush x:Key="RecordingBrush" Color="{DynamicResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{DynamicResource LayerFillColorDefault}" />
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="{DynamicResource SurfaceStrokeColorDefault}" />
        <SolidColorBrush x:Key="OverlayToolbarBrush" Color="{DynamicResource LayerFillColorAlt}" />
        <SolidColorBrush x:Key="StopBrush" Color="{DynamicResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="PlayBrush" Color="{DynamicResource AccentFillColorDefault}" />
        <SolidColorBrush x:Key="CheckboxBrush" Color="{DynamicResource AccentFillColorDefault}" />

        <!-- Global button baseline. Specialized button styles must derive from this style. -->
        <Style x:Key="GlobalButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The implicit style keeps unqualified buttons compliant across every window. -->
        <Style TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}" />
    </Application.Resources>
</Application>
