<Window x:Class="LocalCam.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes"
        Width="520"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="16"
                   Margin="0,0,0,16">
            You have unsaved changes. Do you want to save before closing?
        </TextBlock>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save and Close"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Click="SaveAndClose_Click" />
            <Button Content="Discard Changes"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Click="DiscardChanges_Click" />
            <Button Content="Continue Editing"
                    MinWidth="120"
                    Click="ContinueEditing_Click" />
        </StackPanel>
    </Grid>
</Window>
