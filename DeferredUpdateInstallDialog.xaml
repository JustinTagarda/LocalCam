<Window x:Class="LocalCam.DeferredUpdateInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating LocalCam"
        Width="480"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#161B25"
        Closing="Window_Closing">
    <Border Margin="0"
            Background="#161B25"
            BorderBrush="#2A3242"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Finishing update before closing"
                       Foreground="#E8EEF5"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <TextBlock Grid.Row="1"
                       TextWrapping="Wrap"
                       Foreground="#A9B4C7"
                       FontSize="13"
                       Margin="0,0,0,14"
                       Text="LocalCam is applying the deferred Store update now. Keep the app open until this finishes." />

            <StackPanel Grid.Row="2">
                <ProgressBar x:Name="InstallProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True"
                             Margin="0,0,0,10" />
                <TextBlock x:Name="ProgressTextBlock"
                           Foreground="#8FA2BE"
                           FontSize="12"
                           Text="Preparing update..." />
            </StackPanel>
        </Grid>
    </Border>
</Window>
