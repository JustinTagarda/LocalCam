<Window x:Class="LocalCam.PremiumUpgradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording limit reached"
        Width="520"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Recording limit reached"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,18"
                   Text="Basic recordings stop at 30 minutes. Upgrade to Premium to remove the 30-minute recording stop and keep continuous recording available." />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Upgrade to Premium"
                    MinWidth="132"
                    Margin="0,0,8,0"
                    Click="Upgrade_Click" />
            <Button Content="Not now"
                    MinWidth="90"
                    Click="Dismiss_Click" />
        </StackPanel>
    </Grid>
</Window>
