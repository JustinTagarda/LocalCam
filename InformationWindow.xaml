<Window x:Class="LocalCam.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Information"
        Width="470"
        Height="560"
        MinWidth="470"
        MinHeight="560"
        MaxWidth="470"
        MaxHeight="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DialogTitleText"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="InformationSections" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CopyButton"
                        MinWidth="0"
                        Padding="6"
                        ToolTip="Copy camera information"
                        Style="{StaticResource GlobalButtonStyle}"
                        Click="CopyButton_Click">
                    <Canvas Width="16" Height="16">
                        <Path Data="M5,3 H4 V14 H12 V3 H11 M6,2 H10 V4 H6 Z M6,7 H10 M6,9 H10 M6,11 H9"
                              Fill="{x:Null}"
                              Stroke="{DynamicResource PrimaryTextBrush}"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Button>
                <TextBlock x:Name="CopyStatusText"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Visibility="Collapsed" />
            </StackPanel>

            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource GlobalButtonStyle}"
                    Content="Close"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
